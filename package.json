{
  "name": "code-clash-leaderboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "admin:sync": "node --no-warnings --experimental-strip-types scripts/seed-admin.ts",
    "seed:monitor": "node --no-warnings --experimental-strip-types scripts/seed-monitor.ts",
    "seed:review-demo": "node --no-warnings --experimental-strip-types scripts/seed-review-demo.ts",
    "predev": "node --no-warnings --experimental-strip-types scripts/dev-doctor.ts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test:permissions": "vitest run",
    "test:signin": "playwright test tests/signin.spec.ts",
