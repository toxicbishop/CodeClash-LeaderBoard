# =============================================================================
# Local Supabase Development Environment Variables
# Copy this file to .env.local:
#   cp .env.example .env.local
# Run 'supabase status' to retrieve your local keys.
# =============================================================================

# Supabase Local API Gateway (default port 54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local anon key (get this from running 'supabase status')
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_here

# Local service role key (get this from running 'supabase status')
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

# Server-only settings for pnpm admin:sync. Choose a password in .env.local.
COMPETITION_ADMIN_EMAIL=admin@example.com
COMPETITION_ADMIN_PASSWORD=your_admin_password_here

# Master Lab Admin credentials for pnpm seed:monitor
MASTER_LAB_ADMIN_EMAIL=masterlab@example.com
MASTER_LAB_ADMIN_PASSWORD=your_master_lab_admin_password_here

# Institutional Monitor credentials for pnpm seed:monitor
HOD_EMAIL=hod@example.com
HOD_PASSWORD=your_hod_password_here

PRINCIPAL_EMAIL=principal@example.com
PRINCIPAL_PASSWORD=your_principal_password_here

# Direct local PostgreSQL connection string (default port 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
